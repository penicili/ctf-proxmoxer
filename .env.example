# ===== APPLICATION CONFIGURATION =====
APP_NAME=ansi-ctf
VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# ===== DATABASE CONFIGURATION =====
DB_PLATFORM=sqlite
DB_USER=user
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ctf_db
DB_URL=sqlite:///./ctf_platform.db
# For PostgreSQL: postgresql://user:password@localhost/ctf_db
# For MySQL: mysql+pymysql://user:password@localhost:3306/ctf_db

# ===== PROXMOX CONFIGURATION =====
PROXMOX_HOST=localhost
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=examplepassword
PROXMOX_NODE=pve
PROXMOX_VERIFY_SSL=false

# ===== SSH CONFIGURATION =====
SSH_USERNAME=root
SSH_PASSWORD=ctfadmin
SSH_KEY_PATH=~/.ssh/id_rsa
SSH_PORT=22
SSH_TIMEOUT=30
VM_SSH_USERNAME=user

# ===== CHALLENGE DEFAULTS =====
DEFAULT_VM_MEMORY=512
DEFAULT_VM_CORES=1
DEFAULT_VM_STORAGE=10G
DEFAULT_CHALLENGE_DURATION=3600
MAX_CONCURRENT_DEPLOYMENTS=10

# ===== FLAG CONFIGURATION =====
FLAG_PREFIX=CTF
FLAG_LENGTH=32
FLAG_CHARSET=ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789

# ===== NETWORK CONFIGURATION =====
# Proxmox VM VMID range
TEMPLATE_VMID=9000
STARTING_VMID=200
MAX_VMID=500
PUBLIC_BRIDGE=vmbr0
MANAGEMENT_BRIDGE=vmbr1

# VM internal network (cloud-init static IP)
VM_SUBNET=10.10.10
VM_GATEWAY=10.10.10.1
VM_NETMASK=24

# NAT port forwarding (formula: BASE + VMID)
PVE_PUBLIC_IP=192.168.1.102
SSH_PORT_BASE=22000
HTTPS_PORT_BASE=8000

# ===== DOCKER REGISTRY + CI RUNNER =====
# Registry LXC di internal network Proxmox
REGISTRY_HOST=10.10.10.5:5000
# CI runner VM untuk build Docker image (VMID 110 → IP 10.10.10.110)
CI_RUNNER_IP=10.10.10.110

# ===== CTFd API =====
CTFD_URL=http://localhost:4000
CTFD_API_TOKEN=

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=ctf_platform.log
